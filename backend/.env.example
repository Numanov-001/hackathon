# Backend reads this file when backend/.env is missing.
# A local backend/.env overrides these values.
# Do not add a Clerk secret key or ANTHROPIC_API_KEY.

APP_NAME=marketch.uz
APP_ENV=local
DEBUG=true

# SQLite for local demo. Postgres later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bozor_analitika
DATABASE_URL=sqlite:///./bozor_analitika.db

CORS_ORIGINS=http://localhost:5173

# Same publishable key as frontend VITE_CLERK_PUBLISHABLE_KEY.
# Needed so a paid plan can receive phone numbers. Not a secret key.
CLERK_PUBLISHABLE_KEY=pk_test_YWRhcHRpbmctZHJha2UtNzk4NC5jbGVyay5hY2NvdW50cy5kZXYk

# Not used by the on-page assistant. That bot reads GROQ_API_KEY from frontend/.env.
# Leave empty. POST /api/chat then uses the keyword fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
CHAT_RATE_LIMIT_PER_MINUTE=10

REC_PRICE_WEIGHT=0.5
REC_LOCATION_WEIGHT=0.3
REC_VOLUME_WEIGHT=0.2
