# Copy to backend/.env in this folder. Commit this template, never backend/.env.
# Values below are safe defaults. Put the real Clerk publishable key only in .env.

APP_NAME=marketch.uz
APP_ENV=local
DEBUG=true

# SQLite for local demo. Postgres later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bozor_analitika
DATABASE_URL=sqlite:///./bozor_analitika.db

CORS_ORIGINS=http://localhost:5173

# Same value as frontend VITE_CLERK_PUBLISHABLE_KEY. Verifies the session so a
# paid plan can receive phone numbers. Do not put a Clerk secret key here.
CLERK_PUBLISHABLE_KEY=

# Not used by the on-page assistant. That bot reads GROQ_API_KEY from frontend/.env.
# Leave empty. POST /api/chat then uses the keyword fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
CHAT_RATE_LIMIT_PER_MINUTE=10

REC_PRICE_WEIGHT=0.5
REC_LOCATION_WEIGHT=0.3
REC_VOLUME_WEIGHT=0.2
