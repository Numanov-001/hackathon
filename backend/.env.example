APP_NAME=marketch.uz
APP_ENV=local
DEBUG=true

# Local default: SQLite. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bozor_analitika
DATABASE_URL=sqlite:///./bozor_analitika.db

CORS_ORIGINS=http://localhost:5173

# Unused by the on-page assistant. That bot reads GROQ_API_KEY from frontend/.env.
# Leave empty to use keyword intent fallback on POST /api/chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
CHAT_RATE_LIMIT_PER_MINUTE=10

REC_PRICE_WEIGHT=0.5
REC_LOCATION_WEIGHT=0.3
REC_VOLUME_WEIGHT=0.2
