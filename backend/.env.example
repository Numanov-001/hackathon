APP_NAME=Bozor-Analitika
APP_ENV=local
DEBUG=true

# Local default: SQLite. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bozor_analitika
DATABASE_URL=sqlite:///./bozor_analitika.db

CORS_ORIGINS=http://localhost:5173

# Leave empty to use keyword intent fallback (demo still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
CHAT_RATE_LIMIT_PER_MINUTE=10

REC_PRICE_WEIGHT=0.5
REC_LOCATION_WEIGHT=0.3
REC_VOLUME_WEIGHT=0.2
