# Leave empty in local Vite to use the /health proxy.
# Set only if the frontend talks to backend directly.
VITE_API_BASE_URL=

# Admin rasmlar kaliti. Bo‘sh qoldirilsa, faqat local DEV da "bozor-admin" ishlaydi.
VITE_ADMIN_PIN=

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clerk Dashboard → API Keys → Publishable key (pk_test_...). Secret key gitga yozilmaydi.
VITE_CLERK_PUBLISHABLE_KEY=
