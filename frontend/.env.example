# Copy to frontend/.env. Do not commit frontend/.env.
# Leave API base empty so Vite proxies /api to the local backend.
VITE_API_BASE_URL=

# Clerk Dashboard → API Keys → Publishable key. Never put the secret key here.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase → Project Settings → API. Publishable/anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Empty means the admin photo panel stays locked outside local dev.
VITE_ADMIN_PIN=

# Chat LLM. Vite and Vercel read this on the server. It is not a VITE_ variable,
# so the browser bundle does not receive it. Leave empty to use the local replies.
GROQ_API_KEY=
GROQ_MODEL=
