# Publishable keys below are already set, so a new machine can sign in.
# `npm run dev` copies this file to frontend/.env when that file is missing.
# Do not add GROQ_API_KEY or a Clerk secret key.

# Empty = the Vite dev server proxies /api to http://127.0.0.1:8000.
# Set a full origin only when the frontend is hosted apart from the API.
VITE_API_BASE_URL=

# Clerk publishable key. Same value as backend CLERK_PUBLISHABLE_KEY.
# This is the public key. Never put the Clerk secret key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YWRhcHRpbmctZHJha2UtNzk4NC5jbGVyay5hY2NvdW50cy5kZXYk

# Product photos. Public project URL and publishable key, not the service role.
VITE_SUPABASE_URL=https://qzpkminownoutpjxnkwh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OVAn9L_V4zsPkdBrb64E5g_TLf6TQbV

# Declared for older screens. The current UI does not read it. Leave empty.
VITE_ADMIN_PIN=

# Optional assistant. No VITE_ prefix, so Vite does not ship it to the browser.
# Empty = replies are built from the prices already on screen.
GROQ_API_KEY=
GROQ_MODEL=
