# Copy to frontend/.env in this folder. Commit this template, never frontend/.env.
# Leave secrets empty here. Fill them in .env.

# Empty = the Vite dev server proxies /api to http://127.0.0.1:8000.
# Set a full origin only when the frontend is hosted apart from the API.
VITE_API_BASE_URL=

# Clerk Dashboard → API keys → Publishable key.
# Copy the same value to backend CLERK_PUBLISHABLE_KEY.
# Never put the Clerk secret key in either file.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. Product photos only. Publishable/anon key, not the service role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Declared for older screens. The current UI does not read it. Leave empty.
VITE_ADMIN_PIN=

# Optional assistant. No VITE_ prefix, so Vite does not ship it to the browser.
# Empty = replies are built from the prices already on screen.
GROQ_API_KEY=
GROQ_MODEL=
